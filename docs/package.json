{
  "name": "ohana-site",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "api:dev": "redoc-cli serve ../openapi.yaml --watch",
