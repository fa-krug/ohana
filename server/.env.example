# Ohana: settings come from the environment (docker-compose*.yml set them for the containers).

# Modules turned off on this server (comma list: finance, meals, appointments, chores, assistant). Their
# routes answer 404, the worker skips their jobs, the app hides them. The calendar is always on.
DISABLED_MODULES=

# Signs the passkey ceremony cookie and keys the secret store below when ENCRYPTION_KEY
# isn't set. Required in production: `openssl rand -hex 32`.
AUTH_SECRET=
# The public URL, for links in invites, setup links and notifications, and for passkeys.
# Cookies are marked Secure when it starts with https://.
APP_URL=http://localhost:3000
DATABASE_FILE=./data/ohana.db
# Recipe images (image default /app/data/media, inside the data volume).
MEDIA_ROOT=./data/media

# Passkeys: by default the domain (RP id) and origin come from APP_URL. Set these only to
# allow more than one (comma-separated lists), e.g. an old domain during a move.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_NAME=Ohana

# Secrets at rest (notification channel tokens, SMTP passwords, the AI and search keys) are
# encrypted with AES-256-GCM. The key: ENCRYPTION_KEY (32 random bytes, base64:
# `openssl rand -base64 32`), or, if unset, a key derived from AUTH_SECRET (HKDF). Changing
# either makes the stored secrets unreadable (enter them again).
ENCRYPTION_KEY=

# Worker: backups
BACKUP_DIR=./data/backups
BACKUP_KEEP=14
BACKUP_HOUR=3
WORKER_TICK_SECONDS=60

# Worker: daily notifications (phase 7), server time (TZ)
# from this hour: uncovered days in the next two weeks
NOTIFY_HOUR=7
# the week ahead (phase 11): on this weekday (0 = Sunday) from this hour; 0 turns off looking up
# event locations with Photon for its travel checks
DIGEST_WEEKDAY=0
DIGEST_HOUR=18
# DIGEST_GEOCODE=0

# Notifications to the app (phase 9): the push relay that holds the app's APNs key (relay/).
# Unset: fa-krug's, https://ohana-push.fa-krug.de. Empty: push to the app is off. The relay
# only sees encrypted payloads; the server needs outbound HTTPS to it.
# PUSH_RELAY_URL=

# Assistant: let the family's AI endpoint be on a private network (e.g. Ollama on the home
# network or localhost). Web pages the assistant reads stay limited to public addresses.
AI_ALLOW_PRIVATE_ENDPOINT=
# Worker: how often chats waiting for a turn are looked for (ms), and turns at once
ASSISTANT_TICK_MS=1000
ASSISTANT_MAX_CONCURRENT=4
# "Assistant finished" notification (if the family turned it on): turns longer than this
ASSISTANT_NOTIFY_AFTER_SECONDS=30

# Worker: appointment searches
# how often due searches (and "Run now") are picked up
APPT_TICK_SECONDS=15
# searches running at once
APPT_MAX_CONCURRENT=2
# per request to Doctolib / jameda / notification services
APPT_REQUEST_TIMEOUT_SECONDS=30
# a dead worker's search is free again after this
APPT_RUN_LEASE_MINUTES=30
# run history kept
APPT_RUN_RETENTION_DAYS=30
# ± jitter on interval schedules
SCHEDULE_JITTER_PERCENT=15
# providers checked in parallel within one search
DOCTOLIB_CONCURRENCY=5
# Doctolib profiles (motives, agendas) are cached this long
PROFILE_CACHE_TTL_DAYS=7

PORT=3000
# The address the server listens on.
HOST=0.0.0.0
