#!/bin/sh
# leuchtfeuer-hook v1 (committed): generated by Leuchtfeuer, regenerate it instead of editing it.
#
# Checks the staged changes before every commit with `leuchtfeuer precommit`: Gitleaks on the
# staged diff plus the fast single-file scanners of the pre-commit bundle. Only findings on changed
# lines block. Offline: nothing is uploaded.
#
# Activate once per clone (covers every worktree; each runs the version of its own branch):
#   sh .githooks/pre-commit install      (or: leuchtfeuer hook install)
# Skip once: git commit --no-verify. Deactivate: leuchtfeuer hook uninstall.
#
# The Leuchtfeuer CLI and Gitleaks come from PATH or, when missing, from the Leuchtfeuer server
# (LEUCHTFEUER_URL overrides the address below). Downloads are cached in
# <git common dir>/leuchtfeuer/bin and refreshed once a day, so they follow the server's versions.
set -u
default_server='https://leuchtfeuer.fa-krug.de'
server=${LEUCHTFEUER_URL:-$default_server}
server=${server%/}

die() {
	echo "leuchtfeuer: $*" >&2
	exit 1
}

if [ "${1:-}" = install ]; then
	# Install the wrapper below as the clone's pre-commit hook. The wrapper runs this file from the
	# work tree, so pulls update the check without installing again.
	custom=$(git config core.hooksPath || true)
	[ -z "$custom" ] || die "core.hooksPath is set ($custom): call 'sh .githooks/pre-commit' from that hook manager (husky, lefthook, ...) instead"
	hooks=$(git rev-parse --path-format=absolute --git-path hooks) || exit 1
	target="$hooks/pre-commit"
	if [ -f "$target" ] && ! grep -q 'leuchtfeuer-hook' "$target"; then
		die "$target exists: run 'leuchtfeuer hook install --force' to keep it and run it after the Leuchtfeuer check"
	fi
	mkdir -p "$hooks" || exit 1
	cat >"$target.$$" <<'WRAPPER'
#!/bin/sh
# leuchtfeuer-hook v1 (wrapper): runs the committed .githooks/pre-commit of the current work tree,
# so every pull and every worktree uses the current version. Remove: leuchtfeuer hook uninstall.
hook="$(git rev-parse --show-toplevel)/.githooks/pre-commit"
if [ -f "$hook" ]; then sh "$hook" "$@" || exit $?; fi
backup="$(dirname "$0")/pre-commit.leuchtfeuer-backup"
if [ -x "$backup" ]; then exec "$backup" "$@"; fi
WRAPPER
	if ! { chmod 0755 "$target.$$" && mv "$target.$$" "$target"; }; then
		rm -f "$target.$$"
		die "could not write $target"
	fi
	[ "${2:-}" = --quiet ] || echo "Installed $target: every commit in this clone is checked with leuchtfeuer precommit"
	exit 0
fi

common=$(git rev-parse --path-format=absolute --git-common-dir) || exit 1
cache="$common/leuchtfeuer/bin"
os=$(uname -s | tr '[:upper:]' '[:lower:]')
case $(uname -m) in
x86_64 | amd64) arch=amd64 ;;
arm64 | aarch64) arch=arm64 ;;
*) arch=unknown ;;
esac

# fetch <path on the server> <file name>: download into the cache when missing or older than a day.
# A failed refresh keeps the cached file and waits another day, so offline commits stay fast.
fetch() {
	dest="$cache/$2"
	if [ -x "$dest" ] && [ -z "$(find "$dest" -mtime +0 2>/dev/null)" ]; then
		return 0
	fi
	[ -n "$server" ] || return 0
	mkdir -p "$cache" || return 0
	if command -v curl >/dev/null 2>&1; then
		curl -fsSL --connect-timeout 5 --max-time 300 -o "$dest.$$" "$server$1"
	else
		wget -q -T 300 -O "$dest.$$" "$server$1"
	fi && chmod 0755 "$dest.$$" && mv "$dest.$$" "$dest" && return 0
	rm -f "$dest.$$"
	if [ -x "$dest" ]; then touch "$dest"; fi
}

lf=$(command -v leuchtfeuer || command -v lfr || true)
if [ -z "$lf" ]; then
	fetch "/api/v1/downloads/cli/$os/$arch" leuchtfeuer
	lf="$cache/leuchtfeuer"
fi
if ! command -v gitleaks >/dev/null 2>&1; then
	fetch "/api/v1/downloads/tools/gitleaks/$os/$arch" gitleaks
fi
PATH="$PATH:$cache"
export PATH
[ -x "$lf" ] || die "the Leuchtfeuer CLI is not installed and could not be downloaded${server:+ from $server}; install it, set LEUCHTFEUER_URL, or skip the check once with: git commit --no-verify"
exec "$lf" precommit
