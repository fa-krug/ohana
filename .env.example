# Ohana's settings for docker-compose.yml (copy to .env). Only the first block is required;
# server/.env.example lists every setting with its default.

# ---- required ----
# The address people and the app use, with https:// (passkeys need HTTPS and this exact host).
APP_URL=https://ohana.example.com
# A long random secret: `openssl rand -hex 32`. Signs cookies and keys the encryption of stored
# secrets (AI keys, notification tokens) unless ENCRYPTION_KEY is set. Keep it: changing it
# makes the stored secrets unreadable.
AUTH_SECRET=

# ---- optional ----
# A separate key for the stored secrets (`openssl rand -base64 32`).
# ENCRYPTION_KEY=
# Turn modules off (comma list): finance, meals, appointments, assistant. The calendar is always on.
# DISABLED_MODULES=appointments
# Let the families' AI endpoint be on your own network (e.g. Ollama at http://192.168.1.10:11434/v1).
# AI_ALLOW_PRIVATE_ENDPOINT=1
# Notifications to the app go through fa-krug's push relay (https://ohana-push.fa-krug.de),
# which only ever sees encrypted payloads. Leave it empty to turn them off; or name your own relay.
# PUSH_RELAY_URL=
# Nightly database backups in the volume's backups/ folder: how many to keep, from which hour.
# BACKUP_KEEP=14
# BACKUP_HOUR=3
# Daily notifications (server time): uncovered days from NOTIFY_HOUR, shopping lists from
# SHOPPING_REMINDER_HOUR.
# NOTIFY_HOUR=7
# SHOPPING_REMINDER_HOUR=18
