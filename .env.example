# Ohana settings (environment variables). The defaults suit local development.

# Signs session cookies and ceremony state; required in production (openssl rand -hex 32).
AUTH_SECRET=
# The public URL (setup and invite links). Not BASE_URL: Vitest sets that one.
APP_URL=http://localhost:3000

# Passkeys: the domain, a display name, and the allowed origins (comma-separated lists work).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Ohana
WEBAUTHN_ORIGIN=http://localhost:3000

# The SQLite database (image default /app/data/ohana.db).
DATABASE_FILE=./data/ohana.db
# Recipe images (image default /app/data/media, inside the data volume).
MEDIA_ROOT=./data/media

# Nightly backups by the worker.
BACKUP_DIR=./data/backups
BACKUP_KEEP=14
BACKUP_HOUR=3
WORKER_TICK_SECONDS=60

PORT=3000
