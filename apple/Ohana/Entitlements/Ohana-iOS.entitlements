<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Identical in Ohana-macOS.entitlements: shares the API token Keychain item. -->
	<!-- A finished cook timer's notification comes through a Focus. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)de.fa-krug.Ohana</string>
	</array>
</dict>
</plist>
