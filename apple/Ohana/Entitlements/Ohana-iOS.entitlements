<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Identical in Ohana-macOS.entitlements: shares the API token Keychain item. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)de.fa-krug.Ohana</string>
	</array>
	<!-- Push notifications (through the relay, Core/Push). "development" while built from Xcode;
	     exporting for TestFlight / the App Store signs it as production. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
