        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Monat · %@"
          }
        }
      }
    },
    "This needs the assistant, which is turned off on your Ohana server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dafür braucht es den Assistenten, und der ist auf deinem Ohana-Server ausgeschaltet."
          }
        }
      }
    },
    "This plan has wrapped up!": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Plan ist durch!"
          }
        }
      }
