        }
      }
    },
    "On the devices that have notifications turned on": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf den Geräten, auf denen Benachrichtigungen eingeschaltet sind"
          }
