            "value": "Tags"
          }
        }
      }
    },
    "Take back this message": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachricht zurücknehmen"
          }
        }
      }
    },
    "Take out of the split": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus der Aufteilung nehmen"
          }
        }
      }
