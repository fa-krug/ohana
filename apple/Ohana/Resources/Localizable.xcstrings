            "state": "translated",
            "value": "Heute · %@"
          }
        }
      }
    },
    "Today's appointments, calendar entries and birthdays.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heutige Termine, Kalendereinträge und Geburtstage."
          }
        }
      }
    },
    "Toggle that entry on the selected days": {
      "localizations": {
        "de": {
