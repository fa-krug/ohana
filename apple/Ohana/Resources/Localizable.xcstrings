    "This repeat rule can’t be read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Wiederholungsregel lässt sich nicht lesen."
          }
        }
      }
    },
    "This server doesn’t send notifications to the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server sendet keine Benachrichtigungen an die App."
          }
        }
      }
    },
    "This server runs an older version of Ohana. Ask its administrator to update it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Server läuft eine ältere Version von Ohana. Bitte die Person, die ihn betreut, um ein Update."
