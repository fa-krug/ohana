{
  "sourceLanguage": "en",
  "strings": {
    "NSCalendarsFullAccessUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohana gleicht den Kalender deiner Familie mit dem Apple-Kalender ab, den du auswählst."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohana nutzt die Kamera für Rezeptbilder und zum Scannen von Kassenbons."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohana hört zu, wenn du dem Assistenten eine Nachricht diktierst."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohana nutzt deine Fotos für Rezeptbilder."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohana wandelt in Text um, was du dem Assistenten diktierst."
          }
        }
      }
    }
  },
  "version": "1.0"
}