    "NSCameraUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohana nutzt die Kamera für Rezeptbilder und zum Scannen von Kassenbons."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohana hört zu, wenn du dem Assistenten eine Nachricht diktierst."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohana nutzt deine Fotos für Rezeptbilder."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohana schreibt, was der Essensplan braucht, in die Erinnerungsliste, die du auswählst, und der Assistent liest und ändert deine Erinnerungen, wenn du ihn darum bittest."
          }
        }
      }
    },
    "NSRemindersUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohana schreibt, was der Essensplan braucht, in die Erinnerungsliste, die du auswählst, und der Assistent liest und ändert deine Erinnerungen, wenn du ihn darum bittest."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohana wandelt in Text um, was du dem Assistenten diktierst."
          }
        }
      }
    }
