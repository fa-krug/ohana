<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app's: the App Group holds the widgets' source and snapshot, the keychain group
	     the API token they load the overview with. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(OHANA_APP_GROUP)</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)de.fa-krug.Ohana</string>
	</array>
</dict>
</plist>
