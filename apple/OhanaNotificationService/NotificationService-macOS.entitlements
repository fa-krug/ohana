<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Extensions on the Mac are sandboxed; no network: it only decrypts. The app's Keychain
	     group: reads the push key the app stored (PushKey). -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)de.fa-krug.Ohana</string>
	</array>
</dict>
</plist>
